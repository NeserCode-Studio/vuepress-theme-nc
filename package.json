    "@vuepress/plugin-blog": "2.0.0-rc.137",
    "@vuepress/plugin-git": "2.0.0-rc.137",
    "@vuepress/plugin-markdown-container": "2.0.0-rc.135",
    "@vuepress/plugin-nprogress": "2.0.0-rc.135",
    "@vuepress/plugin-reading-time": "2.0.0-rc.137",
    "@vuepress/plugin-search": "2.0.0-rc.137",
    "@vuepress/plugin-seo": "2.0.0-rc.137",
